 void GfxRenderingAPIMetal::DeleteTexture(uint32_t texID) {
+    // SOH_IOS (overlay 0021): this was a no-op, so cache eviction never
+    // freed GPU memory (the MTLTexture lived until its id was reused with
+    // different dims). Command buffers retain in-flight resources, so
+    // releasing here is safe even if the GPU still reads it this frame.
+    if (texID >= mTextures.size()) {
+        return;
+    }
+    TextureDataMetal* t = &mTextures[texID];
+    if (t->texture != nullptr) {
+        // rev2: a mip chain adds one third over the base level.
+        size_t sohIosBytes = (size_t)t->texture->width() * t->texture->height() * 4;
+        if (t->texture->mipmapLevelCount() > 1) {
+            sohIosBytes += sohIosBytes / 3;
+        }
+        mTextureBytes -= sohIosBytes;
+        t->texture->release();
+        t->texture = nullptr;
+    }
+    if (t->msaaTexture != nullptr) {
+        t->msaaTexture->release();
+        t->msaaTexture = nullptr;
+    }
 }
 
