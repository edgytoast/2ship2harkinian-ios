Overlay patch 0035 (reference 0032 ported to MM): export the live camera
basis + focus distance from MM's z_view.c for adaptive stereo convergence,
plus the comfort flags (paused / in-play / aiming). MM deltas vs SoH:
- field is view->at (SoH: lookAt), and MM NORMALIZES dir in place right
  after computing dir_dist — the export rides AFTER normalization, so
  fwd = -dir directly (no re-divide).
- pause condition is MM's IS_PAUSED idiom (state != PAUSE_STATE_OFF ||
  debugEditor != DEBUG_EDITOR_NONE — z64pause_menu.h).
- aim modes: FIRSTPERSON, BOWARROW, BOWARROWZ, SLINGSHOT, DEKUSHOOT (the
  Deku bubble is MM's slingshot-class first-person aim).
The shell already defines every exported global (wave-synced).

--- a/mm/src/code/z_view.c
+++ b/mm/src/code/z_view.c
@@ -396,6 +396,75 @@
     diry /= dir_dist;
     dirz /= dir_dist;
 
+#ifdef __IOS__
+    /* SOH_IOS (overlay 0035): live camera BASIS for stereoscopic 3D. MM's
+     * G_MTX_PROJECTION is viewing*projection COMBINED, so the LUS eye
+     * passes cannot derive the camera axes from it — the eye offset must
+     * run along the CAMERA's right axis (reference device rounds 1-4:
+     * world-space offsets = heading-dependent depth + vertical parallax).
+     * dir is already normalized here (MM delta vs SoH); fwd = -dir. */
+    if (dir_dist > 0.0f) {
+        extern volatile float gSoh3DCamDist, gSoh3DCamP00;
+        extern volatile float gSoh3DCamRight[3], gSoh3DCamFwd[3], gSoh3DCamEye[3];
+        float fwx = -dirx, fwy = -diry, fwz = -dirz;
+        /* right = normalize(cross(forward, up)) — y-up right-handed */
+        float rx = fwy * view->up.z - fwz * view->up.y;
+        float ry = fwz * view->up.x - fwx * view->up.z;
+        float rz = fwx * view->up.y - fwy * view->up.x;
+        float rlen = sqrtf(sqr(rx) + sqr(ry) + sqr(rz));
+        if (rlen > 1e-4f) {
+            gSoh3DCamRight[0] = rx / rlen;
+            gSoh3DCamRight[1] = ry / rlen;
+            gSoh3DCamRight[2] = rz / rlen;
+            gSoh3DCamFwd[0] = fwx;
+            gSoh3DCamFwd[1] = fwy;
+            gSoh3DCamFwd[2] = fwz;
+            gSoh3DCamEye[0] = view->eye.x;
+            gSoh3DCamEye[1] = view->eye.y;
+            gSoh3DCamEye[2] = view->eye.z;
+            {
+                float aspect_now = (f32)(view->viewport.rightX - view->viewport.leftX) /
+                                   (f32)(view->viewport.bottomY - view->viewport.topY);
+                float half_fovx = tanf(view->fovy * 0.5f * (3.14159265f / 180.0f)) * aspect_now;
+                gSoh3DCamP00 = (half_fovx > 1e-4f) ? (1.0f / half_fovx) : 1.0f;
+            }
+            gSoh3DCamDist = dir_dist;
+        }
+    }
+    /* Kaleido pause draws captured-scene layers that fight stereo —
+     * flatten while paused (MM's IS_PAUSED condition). */
+    {
+        extern volatile int gSoh3DPaused;
+        if (gPlayState != NULL) {
+            gSoh3DPaused = (gPlayState->pauseCtx.state != PAUSE_STATE_OFF) ||
+                           (gPlayState->pauseCtx.debugEditor != DEBUG_EDITOR_NONE);
+        }
+    }
+    /* Menus with their own perspective views (file select clouds, title)
+     * are not gameplay — flatten unless the applied view IS the gameplay
+     * view. */
+    {
+        extern volatile int gSoh3DInPlay;
+        gSoh3DInPlay = (gPlayState != NULL) && (view == &gPlayState->view);
+    }
+    /* First-person / aiming cameras: the item model renders inches from
+     * the eye — full stereo doubles it; the interpreter fades depth to the
+     * aim profile. MM set: first person, bow (both), slingshot-class, and
+     * the Deku bubble shot. */
+    {
+        extern volatile int gSoh3DAiming;
+        if (gPlayState != NULL) {
+            Camera* sohCam = GET_ACTIVE_CAM(gPlayState);
+            if (sohCam != NULL) {
+                s16 sohCamMode = sohCam->mode;
+                gSoh3DAiming = (sohCamMode == CAM_MODE_FIRSTPERSON) || (sohCamMode == CAM_MODE_BOWARROW) ||
+                               (sohCamMode == CAM_MODE_BOWARROWZ) || (sohCamMode == CAM_MODE_SLINGSHOT) ||
+                               (sohCamMode == CAM_MODE_DEKUSHOOT);
+            }
+        }
+    }
+#endif
+
     float odirx = old_view.eye.x - old_view.at.x;
     float odiry = old_view.eye.y - old_view.at.y;
     float odirz = old_view.eye.z - old_view.at.z;
