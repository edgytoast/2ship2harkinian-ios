+// SOH_IOS (overlay 0042): file size without loading it (skip-hint for the
+// cosmetic scan). UINT64_MAX = unknown (missing, or an archive type that
+// doesn't implement it) so callers never skip on unknown.
+uint64_t ArchiveManager::GetFileSize(const std::string& filePath) {
+    auto it = mFileToArchive.find(CRC64(filePath.c_str()));
+    if (it == mFileToArchive.end() || it->second == nullptr) {
+        return UINT64_MAX;
+    }
+    return it->second->GetFileSize(CRC64(filePath.c_str()));
+}
+
 bool ArchiveManager::HasFile(const std::string& filePath) {
