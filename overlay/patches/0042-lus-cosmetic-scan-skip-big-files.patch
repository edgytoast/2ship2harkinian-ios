+// SOH_IOS (overlay 0042): uncompressed size WITHOUT loading the file. Only
+// zip_stat (reads the in-memory central directory) — no zip_fopen/zip_fread,
+// so it's ~free per file. Lets the cosmetic scan skip multi-MB textures
+// instead of decompressing the whole pack at boot.
+uint64_t O2rArchive::GetFileSize(uint64_t hash) {
+    if (mZipArchive == nullptr) {
+        return UINT64_MAX;
+    }
+    const std::string* filePath =
+        Context::GetInstance()->GetResourceManager()->GetArchiveManager()->HashToString(hash);
+    if (filePath == nullptr) {
+        return UINT64_MAX;
+    }
+    auto zipEntryIndex = zip_name_locate(mZipArchive, filePath->c_str(), 0);
+    if (zipEntryIndex < 0) {
+        return UINT64_MAX;
+    }
+    struct zip_stat zipEntryStat;
+    zip_stat_init(&zipEntryStat);
+    if (zip_stat_index(mZipArchive, zipEntryIndex, 0, &zipEntryStat) != 0) {
+        return UINT64_MAX;
+    }
+    return (uint64_t)zipEntryStat.size;
+}
