Overlay patch 0019 (reference 0017 analog): "iOS" section in 2S2H's Settings
sidebar — Z-toggle checkbox (gSohIos.ZToggle) and menu-scale slider
(gSohIos.MenuScale, consumed at Gui init by overlay 0017). Uses BenMenu's
declarative API; deltas vs reference: no RaceDisable/ShowButtons in 2S2H's
UIWidgets. Anchored between the Controls and Overlay sections.
__IOS__-gated; desktop build unchanged.

--- a/mm/2s2h/BenGui/BenMenu.cpp
+++ b/mm/2s2h/BenGui/BenMenu.cpp
@@ -648,6 +648,31 @@
         .WindowName("2S2H Input Editor")
         .Options(ButtonOptions().Tooltip("Enables the separate Bindings Window.").Size(Sizes::Inline));
 
+#ifdef __IOS__
+    // SOH_IOS (overlay 0019): phone-specific settings. The touch overlay
+    // itself lives in the app shell (SohIosShell.m); these CVars are its
+    // knobs. Menu scale is consumed at Gui init (overlay 0017).
+    path.sidebarName = "iOS";
+    AddSidebarEntry("Settings", "iOS", 1);
+    AddWidget(path, "Touch Controls", WIDGET_SEPARATOR_TEXT);
+    AddWidget(path, "Z Button is a Toggle", WIDGET_CVAR_CHECKBOX)
+        .CVar("gSohIos.ZToggle")
+        .Options(CheckboxOptions()
+                     .Tooltip("On: tapping the on-screen Z locks Z-targeting until tapped again (the button lights "
+                              "up while held). Off: Z is held only while your finger is on it. Physical controllers "
+                              "are unaffected.")
+                     .DefaultValue(true));
+    AddWidget(path, "Menu", WIDGET_SEPARATOR_TEXT);
+    AddWidget(path, "Menu Scale", WIDGET_CVAR_SLIDER_FLOAT)
+        .CVar("gSohIos.MenuScale")
+        .Options(FloatSliderOptions()
+                     .Tooltip("Size of this menu and its text. Takes effect after relaunching the app.")
+                     .IsPercentage()
+                     .Min(0.6f)
+                     .Max(1.2f)
+                     .DefaultValue(0.85f));
+#endif
+
     path.sidebarName = "Overlay";
     path.column = SECTION_COLUMN_1;
     AddSidebarEntry("Settings", "Overlay", 2);
