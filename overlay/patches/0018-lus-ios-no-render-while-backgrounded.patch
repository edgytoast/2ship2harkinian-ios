Overlay patch 0018 (reference 0016 analog): never render while backgrounded.
Device symptom on the Ship of Harkinian port: game unplayably slow after minimize+reopen —
Metal nextDrawable must not run while backgrounded (stall/timeout, watchdog
risk, degraded drawable pool). Gate acquisition on the shell's
SohIos_IsBackgrounded() flag; retry a briefly-null drawable and skip the
frame instead of dereferencing null. Regenerated for this fork's
SetupScreenFramebuffer (same body as reference's; context offsets differ).
Disjoint from 0010's RenderDrawData hunk (D6). __IOS__-only.

--- a/libultraship/src/fast/backends/gfx_metal.cpp
+++ b/libultraship/src/fast/backends/gfx_metal.cpp
@@ -700,9 +700,37 @@
     return (int)index;
 }
 
+#ifdef __IOS__
+// SOH_IOS (overlay 0018): shell-provided background flag (linkage specs
+// must live at file scope, not inside the function).
+extern "C" int SohIos_IsBackgrounded(void);
+#endif
+
 void GfxRenderingAPIMetal::SetupScreenFramebuffer(uint32_t width, uint32_t height) {
     mCurrentDrawable = nullptr;
+#ifdef __IOS__
+    // Park the game thread while backgrounded — nextDrawable in the
+    // background stalls/times out (post-resume slowdown, watchdog risk).
+    // The process suspends moments later and resumes here.
+    {
+        const struct timespec sohIosNap = { 0, 50 * 1000 * 1000 };
+        while (SohIos_IsBackgrounded()) {
+            nanosleep(&sohIosNap, nullptr);
+        }
+        const struct timespec sohIosRetryNap = { 0, 10 * 1000 * 1000 };
+        for (int i = 0; i < 100 && mCurrentDrawable == nullptr; i++) {
+            mCurrentDrawable = mLayer->nextDrawable();
+            if (mCurrentDrawable == nullptr) {
+                nanosleep(&sohIosRetryNap, nullptr); // pool drained (just resumed?)
+            }
+        }
+        if (mCurrentDrawable == nullptr) {
+            return; // skip the frame rather than crash on ->texture()
+        }
+    }
+#else
     mCurrentDrawable = mLayer->nextDrawable();
+#endif
 
     bool msaa_enabled = Ship::Context::GetRawInstance()->GetConsoleVariables()->GetInteger("gMSAAValue", 1) > 1;
 
