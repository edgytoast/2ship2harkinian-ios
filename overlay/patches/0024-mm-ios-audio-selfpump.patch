+//  528 and 544 relate to 60 fps at 32 kHz 32000/60 = 533.333..
+//  in an ideal world, one third of the calls should use num_samples=544 and two thirds num_samples=528
+#define SAMPLES_HIGH 560
+#define SAMPLES_LOW 528
+
+#define AUDIO_FRAMES_PER_UPDATE (R_UPDATE_RATE > 0 ? R_UPDATE_RATE : 1)
+#define NUM_AUDIO_CHANNELS 2
+#ifdef __IOS__
+    // SOH_IOS (0024 rev3): explicit user-interactive QoS on the audio
+    // thread. VP 4K round 2 (2026-07-20): 2 underruns in CALM windows
+    // (max 15/62 ms — impossible via game-loop stalls; the reservoir
+    // outlasts those) = thermal-pressure starvation of a default-QoS
+    // thread. Must run ON this thread; first thing it does.
+    pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+    // SOH_IOS (overlay 0024): the upstream loop below produces audio ONLY on
+    // the game loop's per-tick notify — on iOS the game loop IS the UIKit
+    // main thread, so touch-event/redraw bursts (a pressed thumb delivers up
+    // to 120 Hz) delay the notify past the ring's headroom and the backend
+    // drains to crackle ("fuzzy audio", every sibling port; SoH is clean
+    // because its upstream evolved this exact loop — self-pump + producer
+    // guard + pre-buffer, their fix for clicks #6594). Ported here with
+    // 2S2H's processing/cv_from_thread handshake preserved.
+    auto produce_and_play = [&](u32 num_audio_samples) {
+        // 3 is the maximum authentic frame divisor.
+        static thread_local s16 audio_buffer[SAMPLES_HIGH * NUM_AUDIO_CHANNELS * 3];
+        for (int i = 0; i < AUDIO_FRAMES_PER_UPDATE; i++) {
+            AudioMgr_CreateNextAudioBuffer(audio_buffer + i * (num_audio_samples * NUM_AUDIO_CHANNELS),
+                                           num_audio_samples);
+        }
+        AudioPlayer_Play((u8*)audio_buffer,
+                         num_audio_samples * (sizeof(int16_t) * NUM_AUDIO_CHANNELS * AUDIO_FRAMES_PER_UPDATE));
+    };
+
+    // Self-pump cadence: also wake on a short timeout, independent of the
+    // gfx frame rate (closer to the console, where the audio task ran off
+    // the scheduler rather than gated on rendering).
+    constexpr auto kSelfPumpInterval = std::chrono::milliseconds(5);
+    // The self-pump must wait until the game reaches its render loop, to
+    // avoid touching uninitialized audio state.
+    bool primed = false;
+
     while (audio.running) {
+        bool wasProcessing = false;
         {
             std::unique_lock<std::mutex> Lock(audio.mutex);
+            if (!primed) {
+                while (!audio.processing && audio.running) {
+                    audio.cv_to_thread.wait(Lock);
+                }
+                primed = true;
+            } else if (!audio.processing && audio.running) {
+                audio.cv_to_thread.wait_for(Lock, kSelfPumpInterval);
+            }
+            if (!audio.running) {
+                break;
+            }
+            wasProcessing = audio.processing;
+        }
+
+        {
+            std::unique_lock<std::mutex> Lock(audio.mutex);
+            int samples_left = AudioPlayer_Buffered();
+            int32_t prevMin = sSohIosAudMinBuffered.load();
+            while (samples_left < prevMin && !sSohIosAudMinBuffered.compare_exchange_weak(prevMin, samples_left)) {
+            }
+            int32_t prevMax = sSohIosAudMaxBuffered.load();
+            while (samples_left > prevMax && !sSohIosAudMaxBuffered.compare_exchange_weak(prevMax, samples_left)) {
+            }
+            u32 num_audio_samples = samples_left < AudioPlayer_GetDesiredBuffered() ? SAMPLES_HIGH : SAMPLES_LOW;
+            // Producer guard, rev2: produce while at-or-below Desired (the
+            // documented skip-when-above intent). SoH's exact formula
+            // (Buffered + burst <= Desired) DEGENERATES here: 2S2H inits
+            // DesiredBuffered=1680 == one burst, so it allowed production
+            // only under 96 samples (~3 ms) and the ring hit empty every
+            // cycle (measured aud_min=0/aud_max=1680; the uninstrumented
+            // old loop held 288-2512). Overshoot is bounded to one burst
+            // (<= ~3264), well under the backend's 6000-sample refusal.
+            if (AudioPlayer_Buffered() <= AudioPlayer_GetDesiredBuffered()) {
+                produce_and_play(num_audio_samples);
+            }
+            if (wasProcessing) {
+                audio.processing = false;
+                audio.cv_from_thread.notify_one();
+            }
+        }
