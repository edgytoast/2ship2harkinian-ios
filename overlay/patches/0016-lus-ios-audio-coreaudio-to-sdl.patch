Overlay patch 0016 (reference 0014 analog): on iOS a saved config value of
"coreaudio" (e.g. synced from a macOS install) must map to SDL, not the
compiled-out CoreAudio player (whose switch default would be the silent
Null player). Upstream 5.0.0 moved this parse from Config.cpp into
Audio.cpp's GetSavedAudioBackend(); the hunk is disjoint from 0003's
default-backend hunk below it in the same function (D6).

--- a/libultraship/src/ship/audio/Audio.cpp
+++ b/libultraship/src/ship/audio/Audio.cpp
@@ -80,7 +80,14 @@
     }
 
     if (backendName == "coreaudio") {
+#ifdef __IOS__
+        // CoreAudio player is not built on iOS (HALOutput is macOS-only); a
+        // config synced from macOS would otherwise select the silent Null
+        // player via the switch default. Use SDL (real audio) instead.
+        return AudioBackend::SDL;
+#else
         return AudioBackend::COREAUDIO;
+#endif
     }
 
     if (backendName == "sdl") {
